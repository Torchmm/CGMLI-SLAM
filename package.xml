<?xml version="1.0"?>
<package format="3">
  <name>cgmli_slam</name>
  <version>0.1.0</version>
  <description>Multi-camera visual-inertial SLAM with ROS 2 and offline inputs.</description>
  <maintainer email="noreply@github.com">CGMLI-SLAM maintainers</maintainer>
  <license>LicenseRef-Unspecified</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>eigen</depend>
  <depend>boost</depend>
  <depend>libopencv-dev</depend>
  <depend>libceres-dev</depend>
  <depend>libgoogle-glog-dev</depend>
